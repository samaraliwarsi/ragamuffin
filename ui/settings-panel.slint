// settings
import { Button, VerticalBox, HorizontalBox, LineEdit, TextEdit, ComboBox } from "std-widgets.slint";

export component SettingsPanel inherits Rectangle {
    callback close-clicked();
    callback sync-clicked();
    callback save-settings-clicked(string, string, string, string, string);
    
    in-out property <string> vault-path;
    in-out property <string> system-prompt;
    in-out property <string> mode: "Strict";
    in-out property <string> keep-alive: "5m";
    in-out property <string> history-limit: "10";
    
    width: 100%; 
    height: 100%;
    background: #000000cc; 
    
    Rectangle {
        width: 600px;
        height: 650px;
        background: #252526;
        border-radius: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        
        VerticalBox {
            padding: 20px;
            spacing: 15px;
            
            Text { 
                text: "Settings"; 
                color: #ffffff; 
                font-size: 20px; 
                font-weight: 700;
            }
            // VAULT PATH
            Text { text: "Vault Path:"; color: #aaaaaa; font-size: 14px; }
            HorizontalBox {
                spacing: 10px;
                LineEdit {
                    horizontal-stretch: 1;
                    text <=> root.vault-path;
                    placeholder-text: "C:\\Path\\To\\Vault";
                }
                Button {
                    text: "Save Path";
                    clicked => { root.save-settings-clicked(
                        root.vault-path,
                        root.system-prompt, 
                        root.mode, 
                        root.keep-alive, 
                        root.history-limit); 
                    }
                }
            }
            // SYSTEM PROMPT
            Text { text: "System prompt:"; color: #aaaaaa; font-size: 14px; }
            TextEdit {
                height: 100px;
                text <=> root.system-prompt;
            }

            // Mode & Keep-Alive
            HorizontalBox {
                spacing: 20px;
                VerticalBox {
                    Text { text: "Mode (Strict vs Creative):"; color: #aaaaaa; font-size: 14px; }
                    ComboBox {
                        model: ["Strict", "Creative"];
                        current-value <=> root.mode;
                    }
                }
                VerticalBox {
                    Text { text: "Keep-Alive:"; color: #aaaaaa; font-size: 14px; }
                    ComboBox {
                        model: ["0", "5m", "15m", "1h", "2h", "24h"];
                        current-value <=> root.keep-alive;
                    }
                }
            }

            // History Limit
            Text { text: "Chat History Limit (messages to remember):"; color: #aaaaaa; font-size: 14px; }
            LineEdit {
                text <=> root.history-limit;
                input-type: number;
            }
            
            Rectangle { height: 1px; background: #444; } // Divider
            
            Button { 
                text: "Sync Vault to Database"; 
                clicked => { root.sync-clicked(); } 
            }
            
            Rectangle { } // Spacer

            HorizontalBox {
                spacing: 10px;
                Button { 
                    text: "Save All Settings"; 
                    clicked => { root.save-settings-clicked(root.vault-path, root.system-prompt, root.mode, root.keep-alive, root.history-limit); }
                }
            
                Button { 
                    text: "Close"; 
                    clicked => { root.close-clicked(); } 
                }
            }
        }
    }
}