import { Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component SettingsPanel inherits Rectangle {
    callback close-clicked();
    callback sync-clicked();
    
    background: #000000aa; 
    
    Rectangle {
        width: 400px;
        height: 300px;
        background: #252526;
        border-radius: 10px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        
        VerticalBox {
            padding: 20px;
            spacing: 10px;
            
            Text { text: "Settings"; color: #ffffff; font-size: 20px; }
            
            HorizontalBox {
                spacing: 10px;
                Button { 
                    text: "Sync Vault to Database"; 
                    clicked => { root.sync-clicked(); } 
                }
            }
            
            Rectangle { } // Spacer
            
            Button { 
                text: "Close"; 
                clicked => { root.close-clicked(); } 
            }
        }
    }
}