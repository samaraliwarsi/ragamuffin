import { Button, VerticalBox, HorizontalBox, ScrollView, LineEdit } from "std-widgets.slint";
import { ChatMessage } from "chat-message.slint";
import { SettingsPanel } from "settings-panel.slint";

export struct MessageData {
    role: string,
    content: string,
}

export component MainWindow inherits Window {
    title: "Ragamuffin";
    width: 1000px;
    height: 800px;
    background: #1e1e1e;

    in-out property <[MessageData]> messages: [];
    in-out property <string> current-input: "";
    in-out property <bool> is-loading: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> sidebar-open: true;

    callback send-message(string);
    callback open-settings();
    callback sync-vault();

    HorizontalBox {
        // Sidebar
        Rectangle {
            width: root.sidebar-open ? 250px : 0px;
            clip: true;
            background: #252526;
            
            VerticalBox {
                padding: 15px;
                spacing: 10px;
                Text { text: "Ragamuffin"; color: #d4d4d4; font-size: 18px; font-weight: 700; }
                Button { text: "Settings"; clicked => { root.open-settings(); } }
                Button { 
                    text: "Hide Sidebar"; 
                    clicked => { root.sidebar-open = false; } 
                }
                Rectangle { } // Spacer
            }
        }

        // Main Chat Area
        VerticalBox {
            // Tell this box to take up all remaining horizontal space
            horizontal-stretch: 1;

            // Sidebar toggle row
            HorizontalBox {
                // 'visible' completely removes the space when false (unlike 'if')
                visible: !root.sidebar-open; 
                padding: 10px;
                alignment: start; // Keep button to the left
                
                Button {
                    text: "Show Sidebar";
                    clicked => { root.sidebar-open = true; }
                }
            }
            
            // 1. Scrollable Chat History
            ScrollView {
                // Tell the scroll view to take up all remaining vertical space
                vertical-stretch: 1; 
                
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    for msg in root.messages : ChatMessage {
                        role: msg.role;
                        content: msg.content;
                    }
                }
            }

            // 2. Input Area
            Rectangle {
                height: 80px;
                background: #252526;
                HorizontalBox {
                    padding: 15px;
                    spacing: 10px;
                    
                    LineEdit {
                        horizontal-stretch: 1; // Force input to fill the width
                        text <=> root.current-input;
                        placeholder-text: "Ask about your novel...";
                        edited(text) => { root.current-input = text; }
                    }
                    
                    Button {
                        text: root.is-loading ? "Thinking..." : "Send";
                        enabled: !root.is-loading;
                        clicked => { 
                            if (root.current-input != "") {
                                root.send-message(root.current-input); 
                            }
                        }
                    }
                }
            }
        }
    }

    // Settings Modal overlay
    SettingsPanel {
        visible: root.settings-open;
        close-clicked => { root.settings-open = false; }
        sync-clicked => { root.sync-vault(); }
    }
}