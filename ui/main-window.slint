import { Button, VerticalBox, HorizontalBox, ScrollView, LineEdit } from "std-widgets.slint";
import { ChatMessage } from "chat-message.slint";
import { SettingsPanel } from "settings-panel.slint";

export struct MessageData {
    role: string,
    content: string,
}

export struct AnchorFile {
    name: string,
    selected: bool,
}

export component MainWindow inherits Window {
    title: "Ragamuffin";
    width: 1100px;
    height: 800px;
    background: #1e1e1e;

    in-out property <[MessageData]> messages: [];
    in-out property <[AnchorFile]> anchor-files: []; 
    in-out property <string> current-input: "";
    in-out property <bool> is-loading: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> sidebar-open: true;
    in-out property <bool> anchors-open: false; 
    in-out property <string> notification: ""; // NEW: Notification property

    callback send-message(string);
    callback open-settings();
    callback sync-vault();
    callback toggle-anchor(string); 
    callback clear-anchors();

    HorizontalBox {
        // Sidebar
        Rectangle {
            width: root.sidebar-open ? 280px : 0px;
            clip: true;
            background: #252526;
            
            VerticalBox {
                padding: 15px;
                spacing: 10px;
                
                Text { text: "Ragamuffin"; color: #d4d4d4; font-size: 18px; font-weight: 700; }
                
                HorizontalBox {
                    height: 40px; 
                    spacing: 5px;
                    Button { text: "Settings"; clicked => { root.open-settings(); } }
                    Button { text: "Hide"; clicked => { root.sidebar-open = false; } }
                }

                Rectangle {
                    height: 35px;
                    background: #2a2a2a;
                    border-radius: 4px;
                    
                    TouchArea {
                        clicked => { root.anchors-open = !root.anchors-open; }
                    }
                    
                    HorizontalLayout {
                        padding-left: 10px;
                        Text { 
                            text: root.anchors-open ? "[-] Anchor Files" : "[+] Anchor Files"; 
                            color: #d4d4d4; 
                            font-size: 13px; 
                            vertical-alignment: center;
                        }
                    }
                }
                
                if (root.anchors-open) : VerticalLayout {
                    spacing: 5px;
                    
                    Button {
                        text: "Clear All";
                        clicked => { root.clear-anchors(); }
                    }
                    
                    ScrollView {
                        vertical-stretch: 1;
                        
                        VerticalLayout {
                            spacing: 5px;
                            for file in root.anchor-files : Rectangle {
                                height: 30px;
                                background: file.selected ? #3a3a3a : transparent;
                                border-radius: 4px;
                                
                                TouchArea {
                                    clicked => { root.toggle-anchor(file.name); }
                                }
                                
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    
                                    Rectangle {
                                        width: 14px;
                                        height: 14px;
                                        border-radius: 3px;
                                        border-width: 1px;
                                        border-color: file.selected ? #7F6DF2 : #555;
                                        background: file.selected ? #7F6DF2 : transparent;
                                    }
                                    
                                    Text { 
                                        text: file.name; 
                                        color: file.selected ? #ffffff : #aaaaaa; 
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
                
                Rectangle {
                    visible: !root.anchors-open;
                    vertical-stretch: 1;
                    background: transparent;
                }
            }
        }

        // Main Chat Area
        VerticalBox {
            horizontal-stretch: 1;

            // NEW: Notification Banner
            Rectangle {
                visible: root.notification != "";
                height: 40px;
                background: #7F6DF2;
                HorizontalLayout {
                    padding: 10px;
                    Text { 
                        text: root.notification; 
                        color: white; 
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalBox {
                visible: !root.sidebar-open; 
                padding: 10px;
                alignment: start;
                Button {
                    text: "Show Sidebar";
                    clicked => { root.sidebar-open = true; }
                }
            }
            
            ScrollView {
                vertical-stretch: 1; 
                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;
                    for msg in root.messages : ChatMessage {
                        role: msg.role;
                        content: msg.content;
                    }
                }
            }

            Rectangle {
                height: 80px;
                background: #252526;
                HorizontalBox {
                    padding: 15px;
                    spacing: 10px;
                    LineEdit {
                        horizontal-stretch: 1; 
                        text <=> root.current-input;
                        placeholder-text: "Ask about your novel...";
                        edited(text) => { root.current-input = text; }
                    }
                    Button {
                        text: root.is-loading ? "Thinking..." : "Send";
                        enabled: !root.is-loading;
                        clicked => { 
                            if (root.current-input != "") {
                                root.send-message(root.current-input); 
                            }
                        }
                    }
                }
            }
        }
    }

    SettingsPanel {
        visible: root.settings-open;
        close-clicked => { root.settings-open = false; }
        sync-clicked => { root.sync-vault(); }
    }
}