// main-window.slint
import { Button, VerticalBox, HorizontalBox, ScrollView, LineEdit } from "std-widgets.slint";
import { ChatMessage } from "chat-message.slint";
import { SettingsPanel } from "settings-panel.slint";

export struct MessageData {
    role: string,
    content: string,
    sources: string,
    formatted-message: styled-text,
}

export struct AnchorFile {
    name: string,
    selected: bool,
}


export component MainWindow inherits Window {
    title: "RAGamuffin";
    icon: @image-url("icon.png");
    preferred-width: 1100px; // Default starter
    preferred-height: 800px; // Default starter
    min-width: 600px;
    min-height: 400px;
    background: #1e1e1e;

    in-out property <[MessageData]> messages: [];
    in-out property <[AnchorFile]> anchor-files: []; 
    in-out property <string> current-input: "";
    in-out property <bool> is-loading: false;
    in-out property <bool> settings-open: false;
    in-out property <bool> sidebar-open: true;
    in-out property <bool> anchors-open: false; 
    in-out property <string> notification: "";
    in-out property <string> vault-path: "";
    in-out property <string> system-prompt: "";
    in-out property <string> mode: "Strict";
    in-out property <string> keep-alive: "5m";
    in-out property <string> history-limit: "10";
    in-out property <bool> auto-scroll: true;
    

    callback send-message(string);
    callback open-settings();
    callback sync-vault();
    callback toggle-anchor(string); 
    callback clear-anchors();
    callback save-settings(string, string, string, string, string);
    callback copy-text(string);
    callback stop-generation();
    callback clear-history();

    HorizontalBox {
        // Sidebar
        Rectangle {
            width: root.sidebar-open ? 280px : 0px;
            clip: true;
            background: #252526;
            
            VerticalBox {
                padding: 15px;
                spacing: 10px;
                
                Text { text: "RAGamuffin"; color: #d4d4d4; font-size: 18px; font-weight: 700; }
                
                HorizontalBox {
                    height: 40px; 
                    spacing: 5px;
                    Button { text: "Settings"; clicked => { root.open-settings(); } }
                    Button { text: "Clear"; clicked => { root.clear-history(); } }
                    Button { text: "Hide"; clicked => { root.sidebar-open = false; } }
                }

                Rectangle {
                    height: 35px;
                    background: #2a2a2a;
                    border-radius: 4px;
                    
                    TouchArea {
                        clicked => { root.anchors-open = !root.anchors-open; }
                    }
                    
                    HorizontalLayout {
                        padding-left: 10px;
                        Text { 
                            text: root.anchors-open ? "[-] Anchor Files" : "[+] Anchor Files"; 
                            color: #d4d4d4; 
                            font-size: 13px; 
                            vertical-alignment: center;
                        }
                    }
                }
                
                if (root.anchors-open) : VerticalLayout {
                    spacing: 5px;
                    
                    Button {
                        text: "Clear All";
                        clicked => { root.clear-anchors(); }
                    }
                    
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 5px;
                            for file in root.anchor-files : Rectangle {
                                height: 30px;
                                background: file.selected ? #3a3a3a : transparent;
                                border-radius: 4px;
                                
                                TouchArea {
                                    clicked => { root.toggle-anchor(file.name); }
                                }
                                
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    
                                    Rectangle {
                                        width: 14px;
                                        height: 14px;
                                        border-radius: 3px;
                                        border-width: 1px;
                                        border-color: file.selected ? #7F6DF2 : #555;
                                        background: file.selected ? #7F6DF2 : transparent;
                                    }
                                    
                                    Text { 
                                        text: file.name; 
                                        color: file.selected ? #ffffff : #aaaaaa; 
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
                
                Rectangle {
                    visible: !root.anchors-open;
                    vertical-stretch: 1;
                    background: transparent;
                }
            }
        }

        // Main Chat Area
        VerticalBox {
            horizontal-stretch: 1;
            spacing: 0;

            // Notification Banner
            Rectangle {
                visible: root.notification != "";
                height: root.notification != "" ? 40px : 0px;
                background: #7F6DF2;
                HorizontalLayout {
                    padding: 10px;
                    Text { 
                        text: root.notification; 
                        color: white; 
                        vertical-alignment: center;
                    }
                }
            }
            // Sidebar button
            HorizontalLayout {
                visible: !root.sidebar-open;
                height: 55px;
                vertical-stretch: 0;
                padding: 10px;
                alignment: start;
                Button {
                    text: "Show Sidebar";
                    clicked => { root.sidebar-open = true; }
                }
                
            }
            // Chat history
            Rectangle {
                vertical-stretch: 1;
                chat-scroll-view := ScrollView {
                    scrolled => {
                        root.auto-scroll = (self.content-y <= min(0px, -self.content-height + self.visible-height) + 20px);
                    };
                    changed content-height => {
                        if (root.auto-scroll) {
                            self.content-y = min(0px, -self.content-height + self.visible-height);
                        }
                    }
                    
                    VerticalLayout {
                        padding: 20px;
                        spacing: 10px;
                        for msg in root.messages : ChatMessage {
                            role: msg.role;
                            content: msg.content;
                            sources: msg.sources;
                            formatted-message: msg.formatted-message;
                            copy-clicked(text) => { root.copy-text(text); }
                        }
                    }
                }
                // --- FLOATING SCROLL TO BOTTOM BUTTON ---
                if (!root.auto-scroll) : Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 10px;
                    
                    x: parent.width - self.width - 20px;
                    y: parent.height - self.height - 20px;
                    z: 10;
                    
                    animate background { duration: 100ms; }
                    background: scroll-btn.has-hover ? #6a5acdcc : #7F6DF2cc;

                    border-width: 1px;
                    border-color: #ffffff33;
                    
                    scroll-btn := TouchArea {
                        clicked => { 
                            root.auto-scroll = true;
                            chat-scroll-view.content-y = min(0px, -chat-scroll-view.content-height + chat-scroll-view.visible-height);
                        }
                    }
                    
                    Text {
                        text: "↓";
                        color: #ffffff;
                        font-size: 14px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            

            Rectangle {
                height: 80px;
                background: #252526;
                HorizontalLayout {
                    padding: 15px;
                    spacing: 10px;
                    cross-axis-alignment: center;

                    LineEdit {
                        horizontal-stretch: 1;
                        text <=> root.current-input;
                        placeholder-text: "Type your query...";
                        edited(text) => { root.current-input = text; }

                        accepted(text) => {
                            if (text != "") {
                                root.auto-scroll = true;
                                root.send-message(text);
                                root.current-input = "";
                            }
                        }
                    }
                    Rectangle {
                        width: 70px;
                        height: 32px;
                        border-radius: 6px;

                        animate background { duration: 100ms; }

                        background: btn-touch.pressed ? 
                            (root.is-loading ? #a02824 : #4b3fa6) : 
                            (btn-touch.has-hover ? 
                                (root.is-loading ? #c9302c : #6a5acd) : 
                                (root.is-loading ? #d9534f : #7f6df2));
                        
                        btn-touch := TouchArea {
                            clicked => {
                                if (root.is-loading) {
                                    root.stop-generation();
                                } else if (root.current-input != "") {
                                    root.auto-scroll = true;
                                    root.send-message(root.current-input);
                                }
                            }
                        }
                        Text {
                            text: root.is-loading ? "Stop" : "Send";
                            color: #ffffff;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    SettingsPanel {
        visible: root.settings-open;
        close-clicked => { root.settings-open = false; }
        sync-clicked => { root.sync-vault(); }
        
        vault-path: root.vault-path;
        system-prompt: root.system-prompt;
        mode: root.mode;
        keep-alive: root.keep-alive;
        history-limit: root.history-limit;
        
        // This passes all 5 settings back to Python
        save-settings-clicked(path, prompt, mode, keepalive, limit) => { 
            root.save-settings(path, prompt, mode, keepalive, limit); 
        }
    }
}