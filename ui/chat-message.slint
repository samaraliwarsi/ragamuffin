export component ChatMessage inherits Rectangle {
    in property <string> role: "user";
    in property <string> content: "";
    
    height: text-layout.preferred-height + 40px;
    background: role == "user" ? #2d2d2d : #1e1e1e;
    border-radius: 8px;

    VerticalLayout {
        padding: 10px;
        spacing: 5px;
        Text { 
            text: role == "user" ? "You" : "AI"; 
            color: #888888; 
            font-size: 12px; 
        }
        text-layout := Text { 
            text: root.content; 
            color: #ffffff; 
            wrap: word-wrap; 
        }
    }
}