
export component ChatMessage inherits Rectangle {
    in property <string> role: "user";
    in property <string> content: "";
    in property <string> sources: "";
    in property <styled-text> formatted-message;
    callback copy-clicked(string);
    
    property <bool> is-copied: false;
    property <bool> pulse-tick: false;

    height: self.preferred-height;

    background: role == "user" ? #2d2d2d : #1e1e1e;
    border-radius: 8px;

    Timer {
        interval: 1500ms;
        running: root.is-copied;
        triggered => { root.is-copied = false; }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 5px;

        HorizontalLayout {
            spacing: 5px;
            Text { 
                text: role == "user" ? "You" : "AI"; 
                color: #888888; 
                font-size: 14px; 
            }

            Rectangle { horizontal-stretch: 1; } // Spacer

            Rectangle {
                width: 40px;
                height: 18px;
                border-radius: 4px;
                background: copy-area.has-hover ? #444444 : transparent;
                copy-area := TouchArea {
                    clicked => { 
                        root.copy-clicked(root.content);
                        root.is-copied = true;
                    }
                }

                Text {
                    text: root.is-copied ? "Copied!" : "Copy";
                    color: root.is-copied ? #7F6DF2 : (copy-area.has-hover ? #ffffff : #666666);
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }          
        }
        if (root.content == "" && root.role == "assistant") : Text {
            text: "Thinking...";
            color: #888888;
            font-size: 14px;
            font-italic: true;
            animate opacity { duration: 800ms; }
            opacity: root.pulse-tick ? 1.0 : 0.4;
            Timer {
                interval: 800ms;
                running: root.content == "" && root.role == "assistant";
                triggered => { root.pulse-tick = !root.pulse-tick; }
            }
        }

        StyledText {
            text: root.formatted-message;
            default-color: #ffffff;
            default-font-size: 14px;
            vertical-alignment: top;
        }

        if (root.sources != "") : Text {
            text: "Sources: " + root.sources;
            color: #7F6DF2;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}